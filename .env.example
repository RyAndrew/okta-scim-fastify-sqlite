# Every variable below is required unless marked otherwise. There are no
# defaults: the service refuses to start and lists whatever is missing or invalid.

# ── Core (scim-fastify-core) ────────────────────────────────────────────────

# HTTPS listener
HOST=0.0.0.0
PORT=3000
SSL_CERT_PATH=/etc/scim-sqlite-bridge/cert.pem
SSL_KEY_PATH=/etc/scim-sqlite-bridge/key.pem

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# The SCIM client sends this as the HTTP Basic password (the username is not checked)
API_KEY=replace-with-a-strong-secret

# SQLite audit database (requests and backend operations). Created if missing.
AUDIT_DB_PATH=./scim-sqlite-bridge-audit.db

# What to do when a request carries an attribute this backend does not store:
#   reject — fail the request with 400
#   ignore — drop the attribute and note it in the audit row
# (This backend stores every attribute core knows, so this rarely applies.)
SCIM_UNSUPPORTED_ATTRIBUTES=reject

# Page size when a list request has no count, and the largest page size served
SCIM_DEFAULT_COUNT=100
SCIM_MAX_COUNT=200

# ── SQLite backend ──────────────────────────────────────────────────────────

# The user and group store. Created if missing. Use a different file from AUDIT_DB_PATH.
SQLITE_DB_PATH=./scim-sqlite-bridge.db

# How passwords sent by the SCIM client are stored:
#   plaintext — as sent; for demos and testing only
#   bcrypt    — a bcrypt hash (passwords over 72 bytes are rejected with 400)
SQLITE_PASSWORD_STORAGE=bcrypt

# bcrypt cost factor, 10 to 15 (each step doubles the work). Required when
# SQLITE_PASSWORD_STORAGE=bcrypt; not read otherwise.
SQLITE_BCRYPT_COST=12
